// on translation:
int main() {
  ...
  // 1. preserve memory for D
  // 2. invoke constructor method with pointer of D
  // 3. invoke method with pointer of D
  ...
}

// but considering modern compiler optimization
// if pointer of D isn't on use, there'd be only invokes without arguments

// class base pointer does not exist, but just data.

template <typename T>
class optional {
  bool hasValue;
  T* data;

  optional() : hasValue(false), data(nullptr) {}

  optional(T t) : hasValue(true) {
    data = (T*)malloc(sizeof(T));
    memcpy(data, &t);
  }

  optional<T>& operator=(void) {
    hasValue = false;
    data = nullptr;
  }

  optional<T>& operator=(T t) {
    hasValue = true;
    data = (T*)malloc(sizeof(T));
    memcpy(data, &t);
  }
}

int main() {
  optional<int> opt_int;

  opt_int = 10;
  // or
  opt_int = {};

  ...
}

